# Salesforce Connected App credentials
# Create a Connected App in Salesforce: Setup -> App Manager -> New Connected App
# Enable OAuth, set callback URL to http://localhost:3000/auth/salesforce/callback
# Selected OAuth Scopes: api, refresh_token, offline_access, id, profile, email
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here
# For a sandbox use https://test.salesforce.com; for a production org with a
# my-domain you can also use https://yourdomain.my.salesforce.com (no trailing slash)
SF_LOGIN_URL=https://login.salesforce.com
SF_CALLBACK_URL=http://localhost:3000/auth/salesforce/callback

# Field on Lead used to track event status. Default per spec: lead_update__c
SF_LEAD_STATUS_FIELD=lead_update__c
SF_STATUS_INVITED=Meeting Scheduled
SF_STATUS_ATTENDED=Event Attendees

# Custom Date/Time fields on Task. ActivityDate (Due Date, date-only) is
# always populated. These two custom datetime fields are populated from the
# event time on invitations and from the scan time on attendance.
SF_TASK_DUE_DATETIME_FIELD=Task_Due_Date__c
SF_TASK_REMINDER_DATETIME_FIELD=Task_Reminder_Date__c

# Salesforce profile names whose users may view all invitations across the
# org and access the admin-only Events tab. Comma-separated.
SF_ADMIN_PROFILE_NAMES=System Administrator

# Express session secret (any long random string)
SESSION_SECRET=replace_with_a_long_random_string

# App
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
