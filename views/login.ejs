<%- include('partials/head', { pageTitle: 'Sign in' }) %>
<body>
  <div class="login-shell">
    <section class="panel-left silk">
      <a class="wordmark" href="/">
        Allegiance <span class="mark-line"></span> <span class="accent">Concierge</span>
      </a>
      <div>
        <span class="t-eyebrow">Event Concierge</span>
        <hr class="rule gold" />
        <h1 class="t-display">An <em>introduction</em> worth keeping.</h1>
        <p class="t-body" style="max-width: 38ch; margin-top: 1.2rem;">
          Issue invitations to your clients, generate hand-numbered tickets, and keep Salesforce in step
          from the moment a guest arrives at the door.
        </p>
      </div>
      <span class="brand-foot">Allegiance Real Estate · Global Investment Advisory</span>
    </section>
    <section class="panel-right">
      <span class="t-eyebrow">Sign in</span>
      <hr class="rule gold" />
      <h2 class="t-headline">Begin with your Salesforce credentials</h2>
      <p class="t-body" style="margin-bottom: 2rem;">
        Authentication runs through your Salesforce account so every invitation, attendance log, and
        client record stays attached to you, the introducing agent.
      </p>
      <a href="/auth/salesforce/login" class="btn">Continue with Salesforce</a>
      <hr class="rule" />
      <p class="t-meta">
        Need access? Speak with your administrator to be added to the connected app.
      </p>
    </section>
  </div>
</body>
</html>
