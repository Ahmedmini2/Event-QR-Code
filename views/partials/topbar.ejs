<header class="topbar">
  <a href="/app" class="wordmark">
    Allegiance <span class="mark-line"></span> <span class="accent">Concierge</span>
  </a>

  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" id="nav-toggle" type="button">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div class="nav-drawer" id="nav-drawer" aria-hidden="true">
    <button class="nav-close" aria-label="Close menu" id="nav-close" type="button">&times;</button>
    <nav>
      <a href="/app" class="<%= path === '/app' ? 'active' : '' %>">Overview</a>
      <a href="/app/invite" class="<%= path === '/app/invite' ? 'active' : '' %>">Create Invitation</a>
      <a href="/app/invitations" class="<%= path === '/app/invitations' ? 'active' : '' %>">Invitations Send</a>
      <a href="/app/scan" class="<%= path === '/app/scan' ? 'active' : '' %>">Front desk</a>
      <a href="/app/walkin" class="<%= path === '/app/walkin' ? 'active' : '' %>">Walk-in</a>
      <% if (user && user.isAdmin) { %>
        <a href="/app/events" class="<%= path === '/app/events' ? 'active' : '' %>">Events</a>
      <% } %>
    </nav>
    <div class="agent-tag">
      <span class="agent-label">Agent</span>
      <span class="name"><%= user && user.name ? user.name : '' %></span>
      <form action="/auth/logout" method="post">
        <button class="btn secondary" type="submit">Sign out</button>
      </form>
    </div>
  </div>
  <div class="nav-scrim" id="nav-scrim" hidden></div>
</header>
<script>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var close = document.getElementById('nav-close');
    var drawer = document.getElementById('nav-drawer');
    var scrim = document.getElementById('nav-scrim');
    function open() {
      drawer.classList.add('open');
      scrim.hidden = false;
      document.body.classList.add('drawer-open');
      toggle.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
    }
    function shut() {
      drawer.classList.remove('open');
      scrim.hidden = true;
      document.body.classList.remove('drawer-open');
      toggle.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
    }
    toggle && toggle.addEventListener('click', open);
    close && close.addEventListener('click', shut);
    scrim && scrim.addEventListener('click', shut);
    drawer && drawer.addEventListener('click', function (e) {
      if (e.target.tagName === 'A') shut();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('open')) shut();
    });
  })();
</script>
